# Set your real public origin before deploying (no trailing path).
NEXT_PUBLIC_SITE_URL=
# Keep preview deployments out of search engines. Set true only on the public site.
SITE_INDEXABLE=false

SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only. Set the complete secret in .env.local or your host's secret manager.
SUPABASE_SECRET_KEY=
# Optional for future authenticated endpoints; not needed by this public form.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
